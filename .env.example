# Visit pings to Telegram (same bot as cutitaru.com). Leave empty to disable.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# VISIT_PING_IGNORE_IPS=
# VISIT_PING_IGNORE_UA_SUBSTRINGS=

# Optional Link2Pic Alibaba browser mode
# LINK2PIC_ALIBABA_BROWSER=0
# LINK2PIC_ALIBABA_HEADLESS=true

# Optional ReelSave
# YTDLP_PATH=/usr/local/bin/yt-dlp
# Netscape cookies.txt for Instagram (many Reels need a logged-in session)
# YTDLP_COOKIES_FILE=/var/www/space/secrets/instagram-cookies.txt
